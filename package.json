    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.39.0",
    "multer": "^2.3.0",
    "react": "^19.2.8",
